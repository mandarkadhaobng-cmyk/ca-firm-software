# ── Backend API ───────────────────────────────────────────────────────────────
# Local dev: http://localhost:5000/api
# Production (via Cloudflare Tunnel): https://api.yourfirm.com/api
VITE_API_URL=http://localhost:5000/api

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
VITE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_R2_ACCESS_KEY_ID=your_r2_access_key
VITE_R2_SECRET_KEY=your_r2_secret_key
VITE_R2_BUCKET_NAME=ca-firm-assets
VITE_R2_PUBLIC_URL=https://pub-xxx.r2.dev
